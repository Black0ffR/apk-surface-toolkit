{
  "id": "AS-0034",
  "title": "Attacker input drives component navigation",
  "kind": "smali-taint",
  "check": "smali_taint",
  "severity": "high",
  "maswe": "MASWE-0032",
  "tags": ["ipc", "intent-redirection", "dataflow"],
  "params": {
    "sources": [
      {"name": "getIntent", "match": "name"},
      {"name": "getParcelableExtra", "match": "name"},
      {"name": "getSerializableExtra", "match": "name"},
      {"name": "getStringExtra", "match": "name"},
      {"name": "getData", "match": "name"}
    ],
    "sinks": [
      {"name": "startActivity", "match": "name"},
      {"name": "startService", "match": "name"},
      {"name": "sendBroadcast", "match": "name"},
      {"name": "setClass", "match": "name"}
    ],
    "interprocedural": true,
    "cap": 15,
    "suppress_self_relaunch": true
  },
  "recommendation": "Never let an inbound extra select the target component/action. Allow-list destinations.",
  "repro": "am start -n {package}/{component} --es redirect <internal>"
}
